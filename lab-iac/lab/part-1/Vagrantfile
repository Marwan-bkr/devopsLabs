# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|

  # Le plugin vagrant-vbguest est spécifique à VirtualBox, nous le retirons car
  # nous utilisons QEMU qui n'utilise pas les "Guest Additions" de VirtualBox.
  # if Vagrant.has_plugin?("vagrant-vbguest")
  #   config.vm.provider :virtualbox do |vb|
  #     config.vbguest.auto_update = false
  #   end
  # end

  # Define the VM
  config.vm.define "centos_server" do |server|
    # Spécifier la Vagrant box ARM64 pour QEMU
    server.vm.box = "ppggff/centos-7-aarch64-2009-4K"

    # Spécifier les paramètres de la VM lors de l'utilisation du fournisseur QEMU
    server.vm.provider "qemu" do |qemu|
      qemu.name = "centos.server.local" # Nom de la VM dans QEMU
      qemu.memory = 2048                # RAM de la VM en Mo
      qemu.cpus = 1                     # Nombre de cœurs CPU de la VM
      qemu.arch = "aarch64"             # TRÈS important : spécifier l'architecture ARM64
      # Vous pouvez ajouter d'autres options QEMU ici si nécessaire,
      # par exemple : qemu.extra_qemu_args = ["-cpu", "host"]
    end

    # Les blocs Virtualbox et vmware_desktop sont supprimés ou commentés
    # car nous ne les utilisons plus avec ce Vagrantfile.
    # server.vm.provider "virtualbox" do |vb|
    #   vb.name =  "centos.server.local"
    #   vb.memory = 2048
    #   vb.cpus = 1
    # end
    # config.vm.provider "vmware_desktop" do |vmware|
    #   vmware.vmx["memsize"] = "2048"
    #   vmware.vmx["numvcpus"] = "1"
    # end
  end

  # Start provisioning
  config.vm.provision "shell",
    inline: "echo Hello, World"

  config.vm.provision "shell",
  inline: "echo '127.0.0.1  mydomain-1.local' >> /etc/hosts"

  # Start provisioning
  $script = <<-SCRIPT
  echo I am provisioning...
  date > /etc/vagrant_provisioned_at
  SCRIPT

  config.vm.provision "shell", inline: $script

end
