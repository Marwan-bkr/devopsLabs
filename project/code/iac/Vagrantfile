Vagrant.configure("2") do |config|
  config.vm.define "web_server" do |server|
    server.vm.box = "project/rocky9" 

    server.vm.network "forwarded_port", guest: 80, host: 8080
    server.vm.network "private_network", ip: "192.168.121.240"

    server.vm.provider :libvirt do |libvirt|
      libvirt.driver = "qemu"
      libvirt.machine_type = "q35"
      libvirt.memory = 4096
      libvirt.cpus = 4
      libvirt.arch = "aarch64"
      libvirt.machine_virtual_size = 10
      libvirt.management_network_dnsent = '8.8.8.8'
    end

    server.vm.provision "ansible" do |ansible|
      ansible.compatibility_mode = "2.0"
      ansible.playbook = "playbooks/run.yml"
      server.vm.synced_folder "../webapp", "/vagrant"
      ansible.become = true
    end
  end
end
